programa {
  funcao inicio() {
    inteiro tabela[2][2] // Matriz 2x2 (4 elementos)
    // Preenchendo a matriz:
    tabela[0][0] = 10 // Linha 0, Coluna 0
    tabela[0][1] = 20 // Linha 0, Coluna 1
    tabela[1][0] = 30 // Linha 1, Coluna 0
    tabela[1][1] = 40 // Linha 1, Coluna 1
    // Lendo matriz:
    escreva(tabela[0][0], " ") // 10
    escreva(tabela[0][1], " ") // 20
    escreva(tabela[1][0], " ") // 30
    escreva(tabela[1][1]) // 40
  }
}
