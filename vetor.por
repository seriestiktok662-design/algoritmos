programa {
  funcao inicio() {
    // vetor com 5 posições: indice 0,1,2,3,4
    inteiro numero[5]

    numero[0] = 10 // primeira posição
    numero[1] = 20 // segunda posição
    numero[2] = 30 // terceira posição
    numero[3] = 40 // quarta posição
    numero[4] = 50 // quinta posição (ultima!)

  escreva(numero[0], "\n") // imprime 10 
  escreva(numero[1], "\n") // imprime 20 
  escreva(numero[2], "\n") // imprime 30
  escreva(numero[3], "\n") // imprime 40
  escreva(numero[4], "\n") // imprime 50
  }
}