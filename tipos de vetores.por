programa {
  funcao inicio() {
    
    // Sintaxe: tipo nome[tamanho]

    inteiro notas[5]      // vetor de 5 inteiros
    real alturas[10]      // vetor de 10 reais
    cadeia nomes[3]       // vetor de 3 cadeias
    logico respostas[4]   // vetor de 4 lógicos

    // Atribuindo valores individualmente:

    notas[0] = 5
    notas[1] = 7
    notas[2] = 4
    notas[3] = 9
    notas[4] = 10


    alturas[0] = 1.76
    alturas[1] = 1.67
    alturas[2] = 1.98
    alturas[3] = 1.64
    alturas[4] = 1.78
    alturas[5] = 1.63
    alturas[6] = 1.62
    alturas[7] = 1.70
    alturas[8] = 1.99
    alturas[9] = 1.50


    nomes[0] = "Rafael"
    nomes[1] = "Davi"
    nomes[2] = "Júlia"


    respostas[0] = (verdadeiro)
    respostas[1] = (verdadeiro)
    respostas[2] = (falso)
    respostas[3] = (falso)

    escreva(notas[0], "\n") // 5
    escreva(notas[1], "\n") // 7
    escreva(notas[2], "\n") // 4
    escreva(notas[3], "\n") // 9
    escreva(notas[4], "\n") // 10


    escreva(alturas[0], "\n") // 1.76
    escreva(alturas[1], "\n") // 1.67
    escreva(alturas[2], "\n") // 1.98
    escreva(alturas[3], "\n") // 1.64
    escreva(alturas[4], "\n") // 1.78
    escreva(alturas[5], "\n") // 1.63
    escreva(alturas[6], "\n") // 1.62
    escreva(alturas[7], "\n") // 1.70
    escreva(alturas[8], "\n") // 1.99
    escreva(alturas[9], "\n") // 1.50


    escreva(nomes[0], "\n") // "Rafael"
    escreva(nomes[1], "\n") // "Davi"
    escreva(nomes[2], "\n") // "Júlia"


    escreva(respostas[0], "\n") // (verdadeiro)
    escreva(respostas[1], "\n") // (verdadeiro)
    escreva(respostas[2], "\n") // (falso)
    escreva(respostas[3], "\n") // (falso)
  }
}
