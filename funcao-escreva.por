programa {
  funcao inicio() {
    cadeia nome
    inteiro pontos, idade

    nome = "Davi"
    pontos = 1500
    idade = 16
    escreva("Olá, mundo! \n")
    escreva(nome, " tem ", idade, " anos de idade. \n")
    escreva(nome, " tem ", idade, " anos de idade. ele trabalha muito e tirou um dia de folga para jogar basquete, ele jogou e marcou ", pontos, " pontos." )
  }
}
