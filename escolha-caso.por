programa {
  funcao inicio() {
    inteiro opcao
    escreva("Escolha(1-3):")
    leia(opcao)

    escolha(opcao){
      caso 1:
      escreva("Cadastrar usuário")
      pare
      caso 2:
      escreva("Listar usuários")
      pare
      caso 3:
      escreva("Sair do sistema")
      pare
      caso contrario:
      escreva("Opção invalida!")
    }
  }
}
